{
  "name": "turnos-ya-backend",
  "version": "1.0.0",
  "description": "Backend API RESTful para Turnos Ya",
  "main": "src/server.ts",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "test": "jest --passWithNoTests",
    "test:coverage": "jest --coverage",
    "build": "prisma generate && tsc",
    "start": "node dist/server.js",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:logs": "docker compose logs -f",
    "db:migrate": "prisma migrate dev",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seeds/index.ts",
    "db:push:prod": "node --env-file=.env.production ./node_modules/prisma/build/index.js db push",
    "db:seed:prod": "node --env-file=.env.production ./node_modules/tsx/dist/cli.mjs prisma/seeds/index.ts",
    "db:sync:prod": "node --env-file=.env.production ./node_modules/tsx/dist/cli.mjs scripts/sync-businesses-to-prod.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seeds/index.ts"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "bcrypt": "^6.0.0",
    "cors": "^2.8.5",
    "dotenv": "^18.0.1",
    "express": "^4.18.2",
    "express-async-errors": "^3.1.1",
    "helmet": "^7.0.0",
    "jsonwebtoken": "^9.0.0",
    "nodemailer": "^10.0.11",
    "otplib": "^13.5.0",
    "qrcode": "^1.5.4",
    "zod": "^3.21.4"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.0",
    "@types/cors": "^2.8.13",
    "@types/express": "^4.17.17",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.2",
    "@types/node": "^20.0.0",
    "@types/nodemailer": "^8.0.2",
    "@types/qrcode": "^1.5.6",
    "jest": "^30.5.2",
    "prisma": "^5.22.0",
    "ts-jest": "^29.4.15",
    "ts-node": "^10.9.1",
    "tsx": "^3.12.7",
    "typescript": "^5.1.6"
  }
}
