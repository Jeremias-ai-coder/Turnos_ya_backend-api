# Base de datos MySQL
# Para desarrollo local con Docker:
DATABASE_URL="mysql://root:root@localhost:3306/turnos_ya"
DB_ROOT_PASSWORD=root
DB_NAME=turnos_ya
DB_PORT=3306
PMA_PORT=8080

# Para despliegue en la nube (TiDB Serverless / Railway MySQL / Aiven):
# TiDB requiere SSL estricto. Ejemplo:
# DATABASE_URL="mysql://<usuario>.<prefijo>:<password>@gateway01.<region>.prod.aws.tidbcloud.com:4000/turnos_ya?sslaccept=strict"

# Entorno y Servidor
NODE_ENV=development # Cambiar a "production" en el servicio desplegado
PORT=3000

# Autenticación y Seguridad
# ⚠️ IMPORTANTE: En producción usar una cadena aleatoria de al menos 32 caracteres
JWT_SECRET="cambiar_por_clave_secreta_jwt_segura_y_aleatoria"

# Configuración de Correo:
# Opción A (Recomendada para Render Free / Nube - HTTP Port 443 sin bloqueos de firewall):
# Obtené tu clave gratuita en https://resend.com (3.000 emails/mes gratis)
RESEND_API_KEY=re_tu_api_key_de_resend_aqui
# RESEND_FROM="Turnos Ya <onboarding@resend.dev>" # O tu dominio verificado: "Turnos Ya <notificaciones@tudominio.com>"

# Opción B (SMTP Tradicional - Para desarrollo local o VPS con puertos 587/465 abiertos):
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=tu_email@gmail.com
EMAIL_PASS=tu_app_password_de_gmail
EMAIL_FROM="Turnos Ya <tu_email@gmail.com>"

# Google OAuth 2.0 (Google Cloud Console Client ID)
GOOGLE_CLIENT_ID=tu_google_client_id.apps.googleusercontent.com

# Credenciales iniciales de Admin (Seed inicial opcional - configurar en .env privado)
# SEED_ADMIN_EMAIL="admin@ejemplo.com"
# SEED_ADMIN_PASSWORD="clave_segura_aqui"
# SEED_ADMIN_NAME="Administrador"

# Auto-Ping Keep-Alive (Para evitar que Render Free se duerma tras 15 min de inactividad)
# Render inyecta RENDER_EXTERNAL_URL de forma automática.
# Si deseas forzar una URL o estás en otra plataforma, puedes descomentar:
# KEEP_ALIVE_URL="https://tu-backend.onrender.com"