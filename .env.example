# Base de datos MySQL en Docker
DATABASE_URL="mysql://root:root@localhost:3306/turnos_ya"
DB_ROOT_PASSWORD=root
DB_NAME=turnos_ya
DB_PORT=3306
PMA_PORT=8080

# Autenticación y Servidor
JWT_SECRET="cambiar_por_clave_secreta_jwt"
PORT=3000

# Seed initial admin credentials (opcionales para desarrollo)
SEED_ADMIN_EMAIL="admin@turnosya.com"
SEED_ADMIN_PASSWORD="password_seguro_aqui"

# Configuración de Correo SMTP (Gmail)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=tu_email@gmail.com
EMAIL_PASS=tu_app_password_de_gmail
EMAIL_FROM="Turnos Ya <tu_email@gmail.com>"
