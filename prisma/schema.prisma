generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id                    Int       @id @default(autoincrement())
  name                  String    @db.VarChar(120)
  email                 String    @unique @db.VarChar(150)
  password              String    @db.VarChar(255)
  role                  Role      @default(client)
  phone                 String?   @db.VarChar(30)
  emailNotifications    Boolean       @default(true) @map("email_notifications")
  whatsappNotifications Boolean       @default(true) @map("whatsapp_notifications")
  deletedAt             DateTime?     @map("deleted_at") @db.Timestamp(0)
  businesses            Business[]
  appointments          Appointment[]
  notifications         Notification[]

  @@map("users")
}

enum Role {
  client
  owner
  administrator
}

model Business {
  id          Int       @id @default(autoincrement())
  name        String    @db.VarChar(150)
  description String?   @db.Text
  address     String?   @db.VarChar(255)
  phone       String?   @db.VarChar(30)
  category    String?   @db.VarChar(50)
  logoUrl     String?   @map("logo_url") @db.VarChar(255)
  ownerId     Int       @map("owner_id")
  latitude    Decimal?  @db.Decimal(10, 8)
  longitude   Decimal?  @db.Decimal(11, 8)
  timezone    String?   @db.VarChar(100)
  webhookUrl  String?   @map("webhook_url") @db.VarChar(255)

  owner       User          @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  services    Service[]
  schedules   Schedule[]
  appointments Appointment[]

  @@map("businesses")
}

model Service {
  id                         Int           @id @default(autoincrement())
  businessId                 Int           @map("business_id")
  name                       String        @db.VarChar(150)
  description                String?       @db.Text
  durationMinutes            Int           @default(30) @map("duration_minutes")
  price                      Decimal       @default(0) @db.Decimal(10, 2)
  status                     ServiceStatus @default(pending)
  bufferTime                 Int           @default(0) @map("buffer_time")
  minCancellationNoticeHours Int?          @map("min_cancellation_notice_hours")
  allowReschedule            Boolean       @default(true) @map("allow_reschedule")

  business     Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  appointments Appointment[]

  @@map("services")
}

enum ServiceStatus {
  pending
  approved
  rejected
}

model Schedule {
  id         Int      @id @default(autoincrement())
  businessId Int      @map("business_id")
  dayOfWeek  Int      @map("day_of_week") @db.TinyInt
  startTime  DateTime @map("start_time") @db.Time
  endTime    DateTime @map("end_time") @db.Time

  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@map("work_schedules")
}

model Appointment {
  id                Int               @id @default(autoincrement())
  businessId        Int               @map("business_id")
  serviceId         Int               @map("service_id")
  userId            Int               @map("user_id")
  date              DateTime          @db.Date
  time              DateTime          @db.Time
  status            AppointmentStatus @default(PENDING)
  createdAt         DateTime          @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt         DateTime          @default(now()) @updatedAt @map("updated_at") @db.Timestamp(0)
  cancelledReason   String?           @map("cancelled_reason") @db.Text
  cancelledByUserId String?           @map("cancelled_by_user_id") @db.VarChar(100)
  holdToken         String?           @map("hold_token") @db.VarChar(100)
  holdExpiresAt     DateTime?         @map("hold_expires_at") @db.Timestamp(0)
  reminder1hSent    Boolean           @default(false) @map("reminder_1h_sent")

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  service  Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  review   Review?

  @@map("appointments")
}

model Review {
  id            Int      @id @default(autoincrement())
  appointmentId Int      @unique @map("appointment_id")
  rating        Int      @db.TinyInt
  comment       String?  @db.Text
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamp(0)

  appointment   Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  @@map("reviews")
}

model Notification {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  title     String   @db.VarChar(150)
  message   String   @db.Text
  type      String   @default("INFO") @db.VarChar(50)
  isRead    Boolean  @default(false) @map("is_read")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(0)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notifications")
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  NO_SHOW
}

